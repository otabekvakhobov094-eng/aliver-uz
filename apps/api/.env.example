
# ---- Meta Conversions API (server tomoni) ----
# Brauzer pikseli reklama bloklovchilari va iOS cheklovlari tufayli
# hodisalarning bir qismini yo'qotadi. Server tomoni ularga bog'liq
# emas. Ikkalasi `event_id` bo'yicha birlashtiriladi — shuning uchun
# META_PIXEL_ID bu yerda ham, web'dagi NEXT_PUBLIC_META_PIXEL_ID da ham
# BIR XIL bo'lishi shart.
META_PIXEL_ID=
# Events Manager -> Settings -> Conversions API -> Generate access token
META_CAPI_TOKEN=
# Sozlash paytida: Events Manager -> Test events dagi kod.
# Ishga tushirishdan oldin BO'SHATILADI, aks holda haqiqiy hodisalar
# hisobotga tushmaydi.
META_TEST_EVENT_CODE=
