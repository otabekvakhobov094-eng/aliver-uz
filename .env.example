# ============================================================
# ALIVER.UZ — muhit o'zgaruvchilari namunasi
# Nusxa oling:  cp .env.example .env
# .env hech qachon repozitoriyga qo'shilmaydi.
# ============================================================

NODE_ENV=development
APP_ENV=development                 # development | staging | production
TZ=Asia/Tashkent

# --- API ---
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Ma'lumotlar bazasi ---
DATABASE_URL=postgresql://aliver:aliver_dev@localhost:5432/aliver?schema=public

# --- Redis (kesh, rate limit, rezerv muddati) ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
# Prodda: kamida 48 baytlik tasodifiy qiymat, secret manager orqali beriladi.
JWT_ACCESS_SECRET=dev_access_secret_almashtiring
JWT_REFRESH_SECRET=dev_refresh_secret_almashtiring
JWT_ACCESS_TTL=900                  # 15 daqiqa (soniya)
JWT_REFRESH_TTL=2592000             # 30 kun (soniya)
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false                 # prodda: true

# --- OTP siyosati (ekspertiza A-8) ---
OTP_LENGTH=5
OTP_TTL_SECONDS=300                 # kod 5 daqiqa amal qiladi
OTP_RESEND_COOLDOWN_SECONDS=60      # qayta yuborish oralig'i
OTP_MAX_PER_PHONE_PER_DAY=5         # bir raqamga sutkalik limit
OTP_MAX_VERIFY_ATTEMPTS=5           # noto'g'ri urinishlar limiti
OTP_MAX_PER_IP_PER_HOUR=20          # IP bo'yicha limit
OTP_DEV_FIXED_CODE=11111            # faqat development: SMS yuborilmaydi, shu kod qabul qilinadi

# --- SMS provayder ---
# console — SMS yuborilmaydi, matn logga chiqadi (faqat development).
# eskiz | playmobile — haqiqiy provayder; shartnoma va kalit kerak.
# Productionda `console` TAQIQLANGAN: mijoz buyurtmasidan bexabar qolardi.
SMS_PROVIDER=console
SMS_SENDER=ALIVER
SMS_API_URL=                        # eskiz: https://notify.eskiz.uz/api
SMS_API_LOGIN=                      # eskiz: email, playmobile: login
SMS_API_PASSWORD=
SMS_MAX_ATTEMPTS=5

# --- Bildirishnomalar ---
# Tunda oddiy xabarlar yuborilmaydi va ertalabga suriladi.
# Pulga tegishli xabarlar (to'lov, bekor qilish, qaytarish) va kuryer
# yo'lga chiqqani har doim darhol ketadi.
NOTIFY_QUIET_FROM=22
NOTIFY_QUIET_TO=8

# --- Fayl xotirasi (S3-mos) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=aliver-media
S3_ACCESS_KEY=aliver
S3_SECRET_KEY=aliver_dev_secret
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/aliver-media

# --- To'lov provayderlari ---
# mock    — kalitlar yo'q. To'lov havolasi bizning soxta sahifamizga boradi,
#           webhook imzosi TEKSHIRILMAYDI. Faqat development uchun.
# sandbox — provayderning test muhiti, imzo tekshiriladi.
# live    — jangovar rejim.
# Productionda `mock` ATAYLAB taqiqlangan: ilova ishga tushmaydi.
PAYMENTS_MODE=mock

CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay

PAYME_MERCHANT_ID=
PAYME_KEY=                          # jangovar kalit
PAYME_TEST_KEY=                     # sandbox kaliti
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
PAYME_TRANSACTION_TIMEOUT_MS=43200000   # 12 soat — Payme qoidasi

# --- Uzum (TZ-3) ---
# UZUM_ENABLED sozlamalardan ALOHIDA bayroq va bu ataylab shunday:
# kalitlar to'liq bo'lgani hali integratsiya tayyor degani emas.
# Callback maydonlari va imzo sxemasi Uzum merchant hujjatidan olinadi,
# hujjat esa shartnoma bilan keladi. Kalitlar bor, hujjat yo'q holda
# sotuvga chiqish eng qimmat xato bo'lardi: pul kelardi, biz esa uni
# qaysi buyurtmaga yozishni bilmasdik.
#
# Bayroq qo'yilmaguncha `live` rejimda Uzum 503 qaytaradi va nima
# yetishmayotganini aniq aytadi.
UZUM_ENABLED=false
UZUM_MERCHANT_ID=
UZUM_SERVICE_ID=
UZUM_CHECKOUT_URL=

# --- Sovg'a sertifikati (TZ-3) ---
# Kod BAZADA OCHIQ SAQLANMAYDI, faqat xeshi. Bu sir xeshga qo'shiladi,
# shuning uchun bazani ko'rgan odam mumkin bo'lgan kodlarning xeshini
# oldindan hisoblab qo'ya olmaydi.
#
# Sir O'ZGARTIRILSA barcha mavjud sertifikat kodlari ishlamay qoladi —
# ularning xeshi boshqacha bo'lib qoladi. Uni almashtirish kerak
# bo'lsa, avval eski sir bilan qayta xeshlash rejasi kerak.
GIFTCARD_SECRET=

# --- Fiskal chek / OFD (ekspertiza A-1) ---
# mock  — chek shakllantiriladi va saqlanadi, lekin OFD ga YUBORILMAYDI.
# soliq — haqiqiy provayder (shartnoma imzolangach).
# Productionda `mock` taqiqlangan: chek qonun talabi.
OFD_PROVIDER=mock
OFD_API_URL=
OFD_API_TOKEN=
OFD_TERMINAL_ID=
OFD_MAX_ATTEMPTS=8                  # shundan keyin chek FAILED bo'ladi va admin ko'radi

# --- Telegram bildirishnomalari ---
# Token bo'lmasa maket rejimi: xabar logga chiqadi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=              # masalan AliverUzBot, @ belgisiz
TELEGRAM_WEBHOOK_SECRET=            # Telegram setWebhook secret_token bilan bir xil
TELEGRAM_ORDERS_CHAT_ID=            # operatorlar kanali (masalan -1001234567890)
TELEGRAM_LANG=uz

# --- Analitika (7-etap; faqat rozilikdan keyin yuklanadi) ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# --- Seed ---
# Demo katalog (kategoriyalar, 12 mahsulot). Productionda avtomatik o'chadi.
SEED_DEMO_CATALOG=true

# --- Boshlang'ich super admin (seed) ---
SEED_SUPERADMIN_EMAIL=admin@aliver.uz
SEED_SUPERADMIN_PASSWORD=Admin12345!

# --- Uzum Seller (do'kondan import) ---
# Uzum Seller'da rasmiy OpenAPI bor, lekin spetsifikatsiya kalit bilan
# birga beriladi va tashqaridan yopiq. Shuning uchun YO'LLAR ham
# sozlamada: hujjat kelgach shu yerdagi qatorlarni to'ldirish kifoya,
# kodga tegilmaydi.
#
# DIQQAT: import qilingan sharhlar saytda «Uzum'dan» belgisi bilan
# ko'rsatiladi va «tasdiqlangan xarid» yorlig'ini OLMAYDI — xarid bizda
# emas, Uzum'da qilingan va buni tasdiqlay olmaymiz.
UZUM_SELLER_API_URL=https://api-seller.uzum.uz/api/seller-openapi
UZUM_SELLER_TOKEN=
UZUM_SELLER_SHOP_ID=
# Hujjatdan tasdiqlanadi:
UZUM_SELLER_AUTH_HEADER=Authorization
UZUM_SELLER_AUTH_PREFIX=Bearer
UZUM_SELLER_PRODUCTS_PATH=
UZUM_SELLER_REVIEWS_PATH=
