# ============================================================
# ALIVER.UZ — VPS uchun muhit o'zgaruvchilari.
#
#   cp deploy/vps/.env.production.example .env.production
#
# Fayl repozitoriyga QO'SHILMAYDI (.gitignore da). Undan nusxa
# parol menejerida saqlansin: server yiqilsa, tiklash uchun kerak.
# ============================================================

# ---- Domen ----
DOMAIN=aliver.uz
ADMIN_DOMAIN=admin.aliver.uz
# Sertifikat tugashi haqida ogohlantirish shu manzilga keladi.
CERTBOT_EMAIL=admin@aliver.uz

# ---- Muhit ----
NODE_ENV=production
APP_ENV=production
TZ=Asia/Tashkent

# ---- Manzillar ----
API_URL=https://aliver.uz
WEB_URL=https://aliver.uz
ADMIN_URL=https://admin.aliver.uz
# Brauzer API ga o'z domenidagi /api orqali boradi, shuning uchun
# CORS deyarli ishlatilmaydi. Ro'yxat zaxira sifatida qoladi.
CORS_ORIGINS=https://aliver.uz,https://admin.aliver.uz
NEXT_PUBLIC_WEB_URL=https://aliver.uz

# ---- Ma'lumotlar bazasi ----
# Parolni O'ZGARTIRING. Hosil qilish: openssl rand -base64 32
POSTGRES_USER=aliver
POSTGRES_PASSWORD=ALMASHTIRING_kuchli_parol
POSTGRES_DB=aliver

# ---- JWT ----
# Har biri uchun: openssl rand -base64 48
# Bu kalitlar o'zgarsa, hamma foydalanuvchi tizimdan chiqib ketadi.
JWT_ACCESS_SECRET=ALMASHTIRING_openssl_rand_base64_48
JWT_REFRESH_SECRET=ALMASHTIRING_boshqa_openssl_rand_base64_48
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# ---- Cookie ----
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# ATAYLAB BO'SH. Do'kon va admin panel alohida domenlarda, cookie ham
# alohida bo'lishi kerak: `.aliver.uz` qo'yilsa, admin token'i do'kon
# sahifalariga ham yuborilardi.
COOKIE_DOMAIN=
# Nginx orqasida: bunsiz chastota cheklovlari hamma uchun bitta IP
# bo'yicha ishlab, butun saytni bloklaydi.
TRUST_PROXY=1

# ---- To'lov ----
# `mock` productionda ISHGA TUSHMAYDI — ilova sababini aytib to'xtaydi.
PAYMENTS_MODE=live
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay

PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
PAYME_TRANSACTION_TIMEOUT_MS=43200000

# --- Uzum (TZ-3) ---
# UZUM_ENABLED sozlamalardan ALOHIDA bayroq va bu ataylab shunday:
# kalitlar to'liq bo'lgani hali integratsiya tayyor degani emas.
# Callback maydonlari va imzo sxemasi Uzum merchant hujjatidan olinadi,
# hujjat esa shartnoma bilan keladi. Kalitlar bor, hujjat yo'q holda
# sotuvga chiqish eng qimmat xato bo'lardi: pul kelardi, biz esa uni
# qaysi buyurtmaga yozishni bilmasdik.
#
# Bayroq qo'yilmaguncha `live` rejimda Uzum 503 qaytaradi va nima
# yetishmayotganini aniq aytadi.
UZUM_ENABLED=false
UZUM_MERCHANT_ID=
UZUM_SERVICE_ID=
UZUM_CHECKOUT_URL=

# --- Sovg'a sertifikati (TZ-3) ---
# Kod BAZADA OCHIQ SAQLANMAYDI, faqat xeshi. Bu sir xeshga qo'shiladi,
# shuning uchun bazani ko'rgan odam mumkin bo'lgan kodlarning xeshini
# oldindan hisoblab qo'ya olmaydi.
#
# Sir O'ZGARTIRILSA barcha mavjud sertifikat kodlari ishlamay qoladi —
# ularning xeshi boshqacha bo'lib qoladi. Uni almashtirish kerak
# bo'lsa, avval eski sir bilan qayta xeshlash rejasi kerak.
GIFTCARD_SECRET=

# ---- Fiskal chek (OFD) ----
# Chek qonun talabi: `mock` productionda taqiqlangan.
OFD_PROVIDER=soliq
OFD_API_URL=
OFD_API_TOKEN=
OFD_TERMINAL_ID=
OFD_MAX_ATTEMPTS=8

# ---- SMS ----
# `console` productionda taqiqlangan: mijoz OTP kodini olmay qoladi.
SMS_PROVIDER=eskiz
SMS_SENDER=ALIVER
SMS_API_URL=
SMS_API_LOGIN=
SMS_API_PASSWORD=
SMS_MAX_ATTEMPTS=5

# ---- Telegram (operatorlar kanali) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ORDERS_CHAT_ID=
TELEGRAM_LANG=uz

# ---- Bildirishnomalar ----
NOTIFY_QUIET_FROM=22
NOTIFY_QUIET_TO=8

# ---- Analitika (faqat rozilikdan keyin yuklanadi) ----
GA4_MEASUREMENT_ID=
GTM_CONTAINER_ID=
YANDEX_METRICA_ID=
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
COOKIE_POLICY_VERSION=2026-01

# ---- Fayl xotirasi ----
MEDIA_URL=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---- Seed ----
SEED_DEMO_CATALOG=false
SEED_SUPERADMIN_EMAIL=admin@aliver.uz
# Birinchi kirishdan keyin DARHOL o'zgartiring.
SEED_SUPERADMIN_PASSWORD=ALMASHTIRING_vaqtinchalik_parol
